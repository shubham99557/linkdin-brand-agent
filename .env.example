# LinkedIn Brand Engine — local configuration template.
# Copy is created for you by `npm run setup:local` (which fills in random dev passwords).
# NEVER commit your real .env file. It is git-ignored.

# --- Server -----------------------------------------------------------------
LBE_ENV=development
LBE_HOST=127.0.0.1
LBE_PORT=8787
# Browser origins allowed to make state-changing requests (CSRF protection)
LBE_APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8787,http://localhost:8787
# Set to true only when served over HTTPS
LBE_COOKIE_SECURE=false

# --- Database ---------------------------------------------------------------
# "pglite" = embedded PostgreSQL stored in .data/pglite (no Docker needed).
# Or a PostgreSQL URL, e.g. the Docker database: postgres://postgres:<password>@127.0.0.1:54329/lbe
LBE_DATABASE_URL=pglite
LBE_PGLITE_DIR=.data/pglite
# Password for the local Docker PostgreSQL (docker compose up -d). Generated by setup:local.
LBE_PG_PASSWORD=

# --- AI drafting ------------------------------------------------------------
# "mock" makes no network calls. "anthropic" calls the Claude API (costs money; needs a key).
LBE_DRAFTER=mock
ANTHROPIC_API_KEY=
LBE_ANTHROPIC_MODEL=claude-opus-5-5
LBE_ANTHROPIC_EFFORT=medium

# --- Publishing (Phase 1: mock only — anything else is refused) --------------
LBE_PUBLISHING_PROVIDER=mock
# success | rate_limited | server_error | timeout_after_write | validation_error
LBE_MOCK_BEHAVIOUR=success
LBE_RUN_WORKER=true
LBE_WORKER_INTERVAL_MS=15000
LBE_WORKER_ID=local-worker
# Branding Agent jobs run in the background (queued → running → done); the dashboard shows progress.
LBE_RUN_AGENT_JOBS=true
LBE_AGENT_JOB_INTERVAL_MS=2000
# Optional: enables POST /api/internal/publisher-tick for an external scheduler (32+ chars)
LBE_INTERNAL_JOB_TOKEN=
# Automatic backups while the server runs (P9-04): every N hours (0 = off), keep the newest K. Folder: backups/auto/<env>
LBE_AUTO_BACKUP_HOURS=24
LBE_AUTO_BACKUP_KEEP=14
# P11-01a: read-only Claude connector for Claude Desktop (one tool, get_brand_brain). Keep off unless testing it.
LBE_CONNECTOR=off

# --- Phase 2: live LinkedIn (leave OFF unless the owner approved a pilot stage) ---
# Master switch. "on" is refused unless LBE_ENV=staging.
LBE_LIVE_PUBLISHING=off
# 32 random bytes, base64. Encrypts LinkedIn tokens at rest. Generated by setup:local. Keep secret; losing it means reconnecting.
LBE_TOKEN_ENC_KEY=
LBE_TOKEN_KEY_ID=k1
LBE_LINKEDIN_VERSION=202611
# Must be HTTPS and registered in the LinkedIn app, e.g. https://localhost:8443/api/oauth/linkedin/callback
LBE_LINKEDIN_REDIRECT_URI=
# Founder app: products "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LBE_LINKEDIN_FOUNDER_CLIENT_ID=
LBE_LINKEDIN_FOUNDER_CLIENT_SECRET=
# Company app: a separate app with "Community Management API" only
LBE_LINKEDIN_COMPANY_CLIENT_ID=
LBE_LINKEDIN_COMPANY_CLIENT_SECRET=
# Optional local HTTPS (needed for the OAuth callback): path to a .pfx certificate and its passphrase
LBE_TLS_PFX=
LBE_TLS_PFX_PASSPHRASE=

# --- Synthetic dev users (used only by `npm run db:seed`) --------------------
LBE_DEV_ADMIN_PASSWORD=
LBE_DEV_APPROVER_PASSWORD=
LBE_DEV_FOUNDER_PASSWORD=
LBE_DEV_EDITOR_PASSWORD=
